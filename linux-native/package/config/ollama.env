# OTE-RAG Ollama サービス環境設定（Linux / Docker 版）
#
# 出典: runtime/docker-compose.yml（Linux + Docker + GPU で全評価を通した実績構成）。
# 🔴 行末コメント（VALUE の後ろの # ...）は値の一部として扱われるため書かないこと。

# モデルを一定時間後に VRAM からアンロードしない（既定5分でアンロードされ次リクエストが遅い）。
OLLAMA_KEEP_ALIVE=24h

# 同時リクエスト処理数=1（直列）。単一ユーザーのデスクトップ製品前提。
# 4 にすると KV キャッシュを4倍確保し gemma4:12b の実行時 VRAM が約 15.6GB に膨らみ、
# 16GB GPU に載らず CPU へ転落する（2026-07-14 検証）。上げる場合は VRAM を要確認。
OLLAMA_NUM_PARALLEL=1

# HuggingFace Hub へのアクセスを禁止（モデルコードのリモートDL防止）。
HF_HUB_OFFLINE=1
