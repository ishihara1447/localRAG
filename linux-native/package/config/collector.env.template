# OTE-RAG collector 環境設定（Linux / Docker 版）- install.sh が config/collector.env を生成する。
#
# 出典: windows-native/config/collector.env.template（設定値の正）。
# Docker 版では server と collector が同一コンテナ内の同じシェルから起動されるため
# （anything-llm/docker/docker-entrypoint.sh）、ここの値も両プロセスに渡る。
# ファイルを分けているのは Windows 版と同じ区切りで読めるようにするためで、
# 内容の重複（NODE_ENV / STORAGE_DIR）は server.env と同値である。
#
# 🔴 行末コメント（VALUE の後ろの # ...）は値の一部として扱われるため書かないこと。

NODE_ENV=production
STORAGE_DIR=/app/server/storage
COLLECTOR_HOTDIR_PATH=/app/collector/hotdir
# COLLECTOR_HOST は意図的に未設定（コード既定の 127.0.0.1 で LAN 越しの到達を遮断）。

# Web リンクのスクレイピング（puppeteer/Chromium）は本配布では使わない。
DISABLE_WEB_SCRAPING=true

# --- 完全オフライン強制（2026-07-28 / fork 48c68662） ---
# collector 側にも、文書を1件アップロードしただけで外部へ出る経路が2つある。
# どちらもコード側の既定で塞いであるが、設定ファイル上でも意図を明示しておく。
# 詳細: docs/OFFLINE_INSTALL_HARDENING_2026-07-28.md
#
# (1) 画像PDF/画像の OCR（tesseract.js）。langPath 未指定だと
#     https://cdn.jsdelivr.net/npm/@tesseract.js-data/<lang>/... から言語データを取得する。
#     false = ローカルの <STORAGE_DIR>/models/tesseract/<lang>.traineddata のみを読む。
#     本配布は jpn / eng の言語データを同梱しているため、日本語・英語のスキャンPDFは
#     オフラインのまま取り込める。
OCR_ALLOW_REMOTE=false
#
# (2) 音声ファイルのローカル文字起こし（Xenova/whisper-small, 約250MB）。
#     未同梱。false = huggingface.co へ取りに行かず日本語エラーで停止する。
#     ⚠️ HF_HUB_OFFLINE は Python 用でこの経路には効かない。
RERANKER_ALLOW_REMOTE=false

# PDF 抽出時に、置換文字(U+FFFD)の連なりを「…」(U+2026) へ畳む。
# 🔴 コード側の既定は OFF。2026-07-27 の実測で退行したため意図的に無効にしている。
#   平均 anchor_coverage@8 0.7228 → 0.6965 / hakusho-eval 29/30 → 28/30（2run一致）。
#   有効化するときは true を設定し、対象文書を再取り込みすること。
# PDF_MOJIBAKE_TO_ELLIPSIS=true
