# OTE-RAG server 環境設定（Linux / Docker 版）- install.sh が config/server.env を生成する。
#
# 出典: windows-native/config/server.env.template（設定値の正）と
#       runtime/docker-compose.yml（Linux + Docker + GPU で全評価を通した実績構成）。
#       Windows 固有の項目だけを Docker 向けに読み替え、意味は変えていない。
#
# 🔴 このファイルは docker compose の env_file として読まれる。
#    行末コメント（VALUE の後ろの # ...）は値の一部として扱われるため書かないこと。
#    コメントは必ず行頭から書く。

NODE_ENV=production

# コンテナ内の待受ポート。ホスト側の公開ポートは .env の OTE_RAG_PORT で決まるため、
# ここは 3001 固定でよい（変更するとヘルスチェックとポート公開が食い違う）。
SERVER_PORT=3001

# Windows 版は SERVER_HOST 未設定＝127.0.0.1 で LAN からの到達を遮断している。
# Docker ではホストへポート公開する都合上、コンテナの eth0 で listen する必要があるため
# 0.0.0.0 にする。外部到達の制御は docker-compose.yml の ports 側
# （既定 127.0.0.1 のみ公開）で行う。Windows 版と同じ守り方を別レイヤで実現している。
SERVER_HOST=0.0.0.0

# collector（同一コンテナ内、8888）は server から loopback で叩かれるだけなので
# COLLECTOR_HOST は意図的に未設定（コード既定の 127.0.0.1 を使う）。

# --- ストレージ（コンテナ内パス。ホスト側は <データ領域>/anythingllm-storage にマウント） ---
STORAGE_DIR=/app/server/storage
COLLECTOR_HOTDIR_PATH=/app/collector/hotdir

# --- LLM（同一 compose 内の ollama サービスへ内部ネットワーク経由で接続） ---
LLM_PROVIDER=ollama
OLLAMA_BASE_PATH=http://ollama:11434
OLLAMA_MODEL_PREF=gemma4:12b
OLLAMA_MODEL_TOKEN_LIMIT=8192
OLLAMA_RESPONSE_TIMEOUT=1200000

# gemma4 の thinking を無効化する（think:false）。temperature=0 で thinking が反復暴走し
# 最終回答(content)が空になる「空回答」への対策＋約40倍の高速化（実測 20.8s → 0.5s）。
# 2026-07-21 の A/B で採用確定: think OFF + P1 で ambiguous 15/15 + 15/15（2回完全一致）・
# 空回答ゼロ、hakusho 27〜28/30（think ON 基準 26/30 を上回る）。
# 詳細: docs/GEMMA4_EMPTY_ANSWER_INVESTIGATION_2026-07-21.md
# ⚠️ コード側の既定は OFF（server/utils/AiProviders/ollama/index.js は
#    `process.env.OLLAMA_DISABLE_THINKING === "true"` でのみ有効化する）。
#    設定しないと thinking が有効なままになる。
OLLAMA_DISABLE_THINKING=true

# --- Embedding ---
EMBEDDING_ENGINE=ollama
EMBEDDING_BASE_PATH=http://ollama:11434
EMBEDDING_MODEL_PREF=bge-m3:latest
EMBEDDING_MODEL_MAX_CHUNK_LENGTH=500

# --- Vector DB（内蔵 LanceDB） ---
VECTOR_DB=lancedb

# 日本語 bi-gram BM25 と dense 検索を RRF で融合するハイブリッド検索。
# 2026-07-14/15 の検証で検索漏れ2件が解消（retrieval 2/2）、E2E 11/11・文書外 5/5 維持を確認し既定 ON に確定。
# 詳細: docs/HYBRID_SEARCH_LINUX_VERIFY_RESULT_2026-07-15.md
LANCE_HYBRID_SEARCH=true

# RRF 融合後・topN 切り捨て前に、チャンク単位で bge-reranker-v2-m3 による再順位付けを行う。
# 実測（docs/HYBRID_RERANK_2026-07-27.md）: K=32 で平均 anchor_coverage@8 0.646 → 0.723、
# 設問別の退行ゼロ、目次系設問が 0.33 → 1.00 に回復。hakusho-eval 29/30 は維持。
# 代償: 1問あたりのレイテンシが中央値 約7秒 → 約12秒（CPU ONNX）。
LANCE_HYBRID_RERANK=true

# RRF に渡す候補プール K。🔴 未設定のままにすること（既定の topN×4 = 32）。
# K=50 は retrieval では最高だが hakusho-eval が 29/30 → 27/30 に退行した。
# 上げすぎると悪化する実証もある（arXiv:2411.11767）。
# LANCE_HYBRID_CANDIDATE_LIMIT=32

# 検索後のチャンクを文単位で再順位付けし、上位文と隣接文だけを LLM へ渡す。
# 防衛白書のフェア再評価で baseline 18-19/30 から 24-25/30 へ改善。
# 詳細: docs/RAG_SENTENCE_CUSHION_FAIR_REEVAL_2026-07-15.md
LANCE_SENTENCE_CUSHION=true

# 使用するリランカー。2026-08-04 に BAAI（中国系）の bge-reranker-v2-m3 から
# hotchpotch/japanese-reranker-xsmall-v2（MIT、日本発の系譜のみ）へ差し替えた。
#
# 差し替えの理由と効果（docs/RERANKER_SWAP_2026-08-04.md）:
#   - 中国系モデルを使わないという要件を満たすため
#   - 副次効果として TTFT が中央値 6.99秒 → 約2.9秒に短縮（計算量が約1/38）
#   - 防衛白書30問は 26/30 → 27/30。定義説明 6/6・白書外 5/5 を維持
#   - 同梱サイズが 571MB → 37MB
#
# 🔴 このモデルの config.json は同梱時に model_type を modernbert → xlm-roberta へ
#    書き換えてある。同梱の transformers.js v2 が modernbert を知らないためで、
#    ONNX グラフ自体はアーキテクチャ非依存に実行されるため問題ない。
#    モデルを再取得する場合は同じ書き換えが必要（build-linux.sh は書き換え済みの
#    ファイルを runtime/ から複製する）。
RERANKER_MODEL_PREF=hotchpotch/japanese-reranker-xsmall-v2

# 配布同梱は約 37MB の int8 ONNX のみ。false にすると未同梱の fp32 を要求するため変更禁止。
RERANKER_QUANTIZED=true

# P1: 拒否前の自動言い換え再検索（query reformulation）。検索が弱いとき（0件／dense 実スコア無し／
# 最高スコアが閾値未満）だけ、質問を公式語彙へ1回言い換えて再検索し結果を統合する。
# 口語・省略・通称の質問が本文の公式語彙に届かない語彙ギャップを補う（非破壊）。
# ⚠️ コード側の既定は OFF（server/utils/chats/queryReformulation.js）。設定しないと働かない。
QUERY_REFORMULATION=true

# --- ハードニング既定値（Windows 版と同一。変更不可） ---
DISABLE_TELEMETRY=true
DISABLE_SWAGGER_DOCS=true
WORKSPACE_DELETION_PROTECTION=1

# 新規ワークスペースの検索既定値（fork ae678e28 で追加。日本語複数文書での検索不足対策）
WORKSPACE_DEFAULT_TOP_N=8

# --- 完全オフライン強制（2026-07-28 / fork 48c68662） ---
# ⚠️ HF_HUB_OFFLINE は Python の huggingface_hub 用であり、
#    本製品が使う JavaScript 版 transformers（@xenova/transformers）には効かない。
#    残しているのは将来 Python 系ツールを同梱した場合の保険。
HF_HUB_OFFLINE=1

# JS 版 transformers のオフライン制御はこちら。false = ネットワークへ出ない（既定）。
# true にすると同梱モデルが無いとき huggingface.co / cdn.anythingllm.com へ取りに行く。
# 🔴 顧客環境では絶対に true にしないこと。
# 詳細: docs/OFFLINE_INSTALL_HARDENING_2026-07-28.md
RERANKER_ALLOW_REMOTE=false

# 画像PDF・画像ファイルの文字認識（OCR）で使う言語。未設定だと上流既定の "eng" のみになり、
# 日本語のスキャン文書が英語として誤認識される。jpn/eng の言語データは配布物に同梱済み
# （<STORAGE_DIR>/models/tesseract/）。同梱していない言語をここに足すと、
# OCR_ALLOW_REMOTE=false のため日本語エラーで停止する（CDN へは取りに行かない）。
TARGET_OCR_LANG=jpn,eng

# --- 意図的に「未設定」にしている項目（値を設定しないこと） ---
# COMMUNITY_HUB_BUNDLE_DOWNLOADS_ENABLED:
#   未設定 = Community Hub からの bundle/Agent Skill DL を完全拒否（422）。
#   "false" 等を設定すると逆に verified public アイテムの DL を許可してしまうため設定禁止。
# AGENT_*_API_KEY（SerpAPI, Tavily, Bing 等の外部 Web 検索）:
#   未設定 = 外部 Web 検索 Agent は API キーが無く機能しない（外部通信が発生しない）。
# LOCAL_SERVICE_CONTROL:
#   Windows 版の WinSW 連携（Web UI からの Ollama/Collector 起動停止）専用。
#   Linux/Docker 版には該当機能が無いため未設定＝無効（状態表示のみ）。
#   サービス制御は systemd（ote-rag.service）と start.sh / stop.sh で行う。
