# Node
node_modules/
.pnp.*
.yarn/*
!.yarn/patches
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Env / secrets
.env
.env.*
!.env.example
*.pem
*.key

# AnythingLLM storage / 顧客文書・ベクタ・DB（コミット禁止）
**/storage/
*.db
*.sqlite
*.sqlite3
vector-cache/
lancedb/

# Models / weights / 量子化ファイル（巨大・別管理）
*.gguf
*.safetensors
*.bin
models/
hf-cache/

# Build / cache
dist/
# Linux 配布物のビルド出力（約26GB: パッケージ13GB + tarball 12.3GB + 分割）。
# `dist/` では末尾が違うため一致しない。明示的に除外する。
/dist-linux/
build/
.cache/
coverage/
.vite/
__pycache__/

# OS / editor
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/*
!.vscode/extensions.json

# Logs
logs/
*.log

# AnythingLLM fork 本体（独立 git リポとして管理。親リポからは追跡しない）
/anything-llm/

# Claude Code 個人設定（コミットしない）
.claude/settings.local.json

# 実行時データ（顧客文書・DB・ベクタ・モデルを含むためコミット禁止）
runtime/anythingllm-storage/
runtime/ollama-models/

# 大容量・機微な精度評価用データ（実文書等。コミット禁止）
fixtures/local/

# エージェントが作業用に作るディレクトリ（本来は /tmp を使う。コミットしない）
/scratchpad/
out/**/__pycache__/

# 測定ログは証跡として残す。53行目の *.log で落ちてしまうため個別に解除する。
# リランカーは失敗時に黙って元順序へフォールバックするので、「期待したモデルを
# 実際に読んだ」ことを示すコンテナログが無いと、後から測定の妥当性を検証できない。
!out/**/*.log
