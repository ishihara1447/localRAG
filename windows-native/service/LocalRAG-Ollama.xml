<!--
  LocalRAG-Ollama — WinSW service definition.
  Dedicated Ollama instance for LocalRAG. Runs on 127.0.0.1:11435 so it never
  collides with a customer's own Ollama (11434) or a WSL relay (PoC issue #3).
  Layout assumption (see docs/WINDOWS_NATIVE_PHASE4_DESIGN_2026-07-09.md):
    %BASE%           = <install root>\winsw   (this XML + renamed WinSW exe)
    <install root>\runtime\ollama\ollama.exe
    C:\ProgramData\LocalRAG\{models,logs}
-->
<service>
  <id>LocalRAG-Ollama</id>
  <name>LocalRAG Ollama</name>
  <description>LocalRAG dedicated local LLM runtime (Ollama). Serves granite4.1:8b / granite-embedding:278m on 127.0.0.1:11435. No data leaves this machine.</description>

  <executable>%BASE%\..\runtime\ollama\ollama.exe</executable>
  <arguments>serve</arguments>

  <env name="OLLAMA_HOST" value="127.0.0.1:11435" />
  <env name="OLLAMA_MODELS" value="C:\ProgramData\LocalRAG\models" />
  <env name="OLLAMA_KEEP_ALIVE" value="24h" />
  <!-- 完全オフライン: 既定の Ollama は ollama.com へ約4時間おきに
       model-recommendations / api/tags を取りに行く(実測: 2026-07-24〜08-06 の
       全スケジュール行が consecutive_failures=0 = 送信成功)。顧客の監視ネットワークでは
       この外向き通信だけで導入が止まる。クラウド機能ごと無効化する。 -->
  <env name="OLLAMA_NO_CLOUD" value="1" />
  <!-- 既定の冗長度だと埋め込み1チャンクあたり約550B のログが出る。
       1,756チャンクの文書を90本ほど取り込むと8世代すべてが入れ替わり、
       「大量に入れたが何件か失敗した」という報告を受けた時点で
       失敗時のログが残っていない。運用に必要な情報だけ残す。 -->
  <env name="OLLAMA_DEBUG" value="0" />
  <!-- 単一ユーザーのデスクトップ製品なので並列1。4にするとKVキャッシュを4倍確保し、
       実行時VRAMが数倍に膨らんでGPUに載らずCPUへ転落する(gemma4:12bで2026-07-14検証)。
       VRAM 8GB 機では granite4.1:8b でも余裕が無いため、ここは1から上げないこと。 -->
  <env name="OLLAMA_NUM_PARALLEL" value="1" />

  <logpath>C:\ProgramData\LocalRAG\logs</logpath>
  <log mode="roll-by-size">
    <sizeThreshold>10240</sizeThreshold>
    <keepFiles>16</keepFiles>
  </log>

  <startmode>Automatic</startmode>
  <onfailure action="restart" delay="10 sec" />
  <resetfailure>1 hour</resetfailure>
</service>
