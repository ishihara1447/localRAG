# LocalRAG collector/.env - generated by install.ps1 (do not edit unless instructed).
# {{INSTALL_ROOT}} is replaced at install time.

NODE_ENV=production
STORAGE_DIR={{INSTALL_ROOT}}\app\server\storage
COLLECTOR_HOTDIR_PATH={{INSTALL_ROOT}}\app\collector\hotdir
# COLLECTOR_HOSTは意図的に未設定（コード既定の127.0.0.1でLAN越しの到達を遮断。
# 2026-07-15、serverの/system/api-keys露出脆弱性修正と合わせて対応）。

# Web link scraping (puppeteer/Chromium) is excluded from this build.
DISABLE_WEB_SCRAPING=true

# --- 完全オフライン強制 (2026-07-28) ---
# collector 側にも、文書を1件アップロードしただけで外部へ出る経路が2つある。
# どちらもコード側の既定で塞いであるが、設定ファイル上でも意図を明示しておく。
# 詳細: docs/OFFLINE_INSTALL_HARDENING_2026-07-28.md
#
# (1) 画像PDF/画像のOCR (tesseract.js)。langPath 未指定だと
#     https://cdn.jsdelivr.net/npm/@tesseract.js-data/<lang>/... から
#     言語データを取得する。false = ローカルの
#     <STORAGE_DIR>\models\tesseract\<lang>.traineddata のみを読む。
#     ⚠️ 現行の配布物には言語データを同梱していないため、スキャンPDFの
#        取り込みは「OCRデータが無い」旨の日本語エラーになる(ハングはしない)。
OCR_ALLOW_REMOTE=false
#
# (2) 音声ファイルのローカル文字起こし (Xenova/whisper-small, 約250MB)。
#     未同梱。false = huggingface.co へ取りに行かず日本語エラーで停止する。
#     ⚠️ HF_HUB_OFFLINE は Python 用でこの経路には効かない。
RERANKER_ALLOW_REMOTE=false

# PDF抽出時に、置換文字(U+FFFD)の連なりを「…」(U+2026)へ畳む。
# pdfjs-dist@4.4.168 が目次のリーダー罫線(点線)をU+FFFDとして返す不具合の緩和で、
# 失われている情報は「点線」だけであることを実測で確認している
# (docs/EXCLUSION_FIELD_AND_MOJIBAKE_2026-07-27.md / docs/MOJIBAKE_FIX_2026-07-27.md)。
# 🔴 **コード側の既定はOFF**。2026-07-27の実測で退行したため意図的に無効にしている。
#   平均 anchor_coverage@8 0.7228 → 0.6965 / hakusho-eval 29/30 → 28/30(2run一致)。
#   U+FFFDは3,782→0で狙いどおり消えたが、目次5ページが3,489字短くなり
#   チャンク分割の位相が物理ページ5〜27でずれたことによる移動である。
#   将来のS21(印刷目次パーサ)が `…` を必要とするため実装は残してある。
#   有効化するときは true を設定し**対象文書を再取り込み**すること。
# PDF_MOJIBAKE_TO_ELLIPSIS=true
