# LocalRAG server/.env - generated by install.ps1 (do not edit unless instructed).
# {{INSTALL_ROOT}} and {{SERVER_PORT}} are replaced at install time.
# Secrets (SIG_KEY / SIG_SALT / JWT_SECRET) are auto-generated on first boot.

NODE_ENV=production
SERVER_PORT={{SERVER_PORT}}
# SERVER_HOST/COLLECTOR_HOSTは意図的に未設定（コード既定の127.0.0.1を使う）。
# これによりサーバー(3001)・collector(8888)ともLAN越しに到達不可能になる
# （2026-07-15、管理者パスワード未設定時に/system/api-keysが誰でも読める
# 脆弱性の修正。詳細: docs/API_KEY_EXPOSURE_FIX_2026-07-15.md）。

# Prisma resolves the SQLite DB relative to the source tree (server\storage),
# so STORAGE_DIR must stay at app\server\storage.
STORAGE_DIR={{INSTALL_ROOT}}\app\server\storage
COLLECTOR_HOTDIR_PATH={{INSTALL_ROOT}}\app\collector\hotdir

# --- LLM (dedicated LocalRAG Ollama service on 11435) ---
LLM_PROVIDER=ollama
OLLAMA_BASE_PATH=http://127.0.0.1:11435
# 2026-08-04: VRAM 8GB 対応のため gemma4:12b から差し替えた。
# gemma4:12b は ctx 8192 で 8.4GB を占め、bge-m3(0.6GB) と合わせて 8GB に載らない。
# granite4.1:8b は同一条件で 6.7GB。精度は防衛白書30問で 27/30 対 27/30 の同点
# （改善ではない。docs/LLM_8GB_AB_2026-08-04.md）。
OLLAMA_MODEL_PREF=granite4.1:8b
OLLAMA_MODEL_TOKEN_LIMIT=8192
OLLAMA_RESPONSE_TIMEOUT=1200000

# --- Embedding ---
EMBEDDING_ENGINE=ollama
EMBEDDING_BASE_PATH=http://127.0.0.1:11435
# 2026-08-05: 非中国系化のため BAAI bge-m3 から差し替えた。
# 検索精度は anchor_coverage@8 で 0.7120 → 0.7284（+1.64pt、166問・同一条件）。
# 生成は防衛白書30問で 28/30 → 27/30（−1問。白書外5/5は維持）。
# 詳細: docs/EMBEDDING_SWAP_2026-08-05.md
#
# 🔴 埋め込みを変えると既存ベクトルと互換性が無い（1024次元 → 768次元）。
#    既存環境をアップグレードする場合は全文書の再取り込みが必要。
#
# 接頭辞は不要（モデルカードに指定なし）。したがって
# EMBEDDING_CHUNK_PREFIX / EMBEDDING_QUERY_PREFIX は設定しない。
EMBEDDING_MODEL_PREF=granite-embedding:278m
EMBEDDING_MODEL_MAX_CHUNK_LENGTH=500

# --- Vector DB (built-in LanceDB) ---
VECTOR_DB=lancedb
# 日本語bi-gram BM25とdense検索をRRFで融合する機能。
# 2026-07-14/15の検証で検索漏れ2件が解消(retrieval 2/2)、E2E 11/11・文書外5/5維持を確認し既定ONに確定。
# 残る回答失敗はLLM(gemma4)の抽出問題で検索方式に依らない。詳細: docs/HYBRID_SEARCH_LINUX_VERIFY_RESULT_2026-07-15.md
LANCE_HYBRID_SEARCH=true

# RRF融合後・topN切り捨て前に、チャンク単位でbge-reranker-v2-m3による再順位付けを行う。
# upstreamは `if (rerank) ... else if (hybridSearchEnabled)` の排他分岐のため、
# LANCE_HYBRID_SEARCH=true の既定ではチャンク単位のリランクが一度も走らず、
# 同梱リランカー(571MB)は文単位クッションでしか使われていなかった(2026-07-27に判明)。
# 実測(docs/HYBRID_RERANK_2026-07-27.md): K=32で平均 anchor_coverage@8 0.646→0.723、
# 設問別の退行ゼロ、目次系設問が0.33→1.00に回復。hakusho-eval 29/30 は維持。
# 代償: 1問あたりのレイテンシが中央値 約7秒 → 約12秒(CPU ONNX)。
LANCE_HYBRID_RERANK=true
# RRFに渡す候補プールK。**未設定のままにすること**(既定の topN×4 = 32)。
# K=50 は retrieval では最高だが hakusho-eval が 29/30 → 27/30 に退行した。
# 上げすぎると悪化する実証もある(arXiv:2411.11767。bge-reranker-v2-m3を含む検証)。
# LANCE_HYBRID_CANDIDATE_LIMIT=32

# 検索後のチャンクを文単位で再順位付けし、上位文と隣接文だけをLLMへ渡す。
# 防衛白書のフェア再評価でbaseline 18-19/30から24-25/30へ改善。
LANCE_SENTENCE_CUSHION=true
# 配布同梱はint8 ONNXのみ。falseにすると未同梱fp32を要求するため変更禁止。
RERANKER_QUANTIZED=true

# 🔴 使用するリランカーの明示指定。**この行を消してはならない。**
# コード側の既定は今も旧モデル onnx-community/bge-reranker-v2-m3-ONNX を指しており
# （server/utils/EmbeddingRerankers/native/index.js）、この行が無いと
# 同梱していない旧モデルを探しに行く。リランカーは読み込みに失敗しても
# 例外を投げず黙って元の検索順序へフォールバックするため、
# **エラーにならないまま精度だけが落ちる**。
#
# 🔴 このモデルの config.json は同梱時に model_type を modernbert → xlm-roberta へ
#    書き換えてある。同梱の transformers.js v2 が modernbert を知らないためで、
#    ONNX グラフ自体はアーキテクチャ非依存に実行されるため問題ない。
#    モデルを再取得する場合は同じ書き換えが必要。
#
# 🔴 同梱 ONNX は model_qint8_avx2.onnx（AVX2 向け量子化）をリネームしたもの。
#    旧 bge-reranker-v2-m3 は命令セット非依存だったため、AVX2 依存は本版が初。
RERANKER_MODEL_PREF=hotchpotch/japanese-reranker-xsmall-v2

# gemma4 の thinking を無効化する。有効なままだと本文が空になることがあり、
# 最初の文字が出るまでの時間も伸びる（docs/GEMMA4_EMPTY_ANSWER_INVESTIGATION_2026-07-21.md）。
# コード側の既定は OFF ではないため、明示指定が要る。
OLLAMA_DISABLE_THINKING=true

# 検索が弱かったときに質問を言い換えて再検索する。コード側の既定は無効。
QUERY_REFORMULATION=true

# --- Hardening defaults (same as the Docker build; non-negotiable) ---
DISABLE_TELEMETRY=true
DISABLE_SWAGGER_DOCS=true
WORKSPACE_DELETION_PROTECTION=1

# 新規ワークスペースの検索既定値 (fork ae678e28で追加。日本語複数文書での検索不足対策)
WORKSPACE_DEFAULT_TOP_N=8
# 新規ワークスペースの検索モード。UI の「Accuracy Optimized」を選ぶと
# vectorSearchMode=rerank になり、以前は hybrid 検索が丸ごと無視されていた
# （現在はサーバー側で hybrid を優先するよう修正済み）。既定は default で固定する。
WORKSPACE_DEFAULT_VECTOR_SEARCH_MODE=default

# --- 完全オフライン強制 (2026-07-28) ---
# サーバーは起動のたびに raw.githubusercontent.com からクラウドLLMの
# コンテキスト長一覧を取りに行く(モジュール読み込み時に発火し、DISABLE_TELEMETRY では
# 止まらない)。LLM_PROVIDER=ollama の本製品では1件も使わないデータなので止める。
# 実測(2026-08-06): 止める前は毎起動で取得に成功していた。
OTE_OFFLINE=true
# ⚠️ HF_HUB_OFFLINE は **Python の huggingface_hub 用**であり、
#    本製品が使う JavaScript 版 transformers (@xenova/transformers) には**効かない**。
#    残しているのは将来Python系ツールを同梱した場合の保険であって、
#    これだけではリランカーのオフライン化にはならない。
HF_HUB_OFFLINE=1
# JS版 transformers のオフライン制御はこちら。false = ネットワークへ出ない(既定)。
# 未設定でもコード側の既定が false なので厳格に動く。明示しているのは、
# 「意図的にオフライン固定している」ことを設定ファイル上で読み取れるようにするため。
# true にすると同梱モデルが無いとき huggingface.co / cdn.anythingllm.com へ取りに行く
# (2026-07-28に fetch 実測で確認)。**顧客環境では絶対に true にしないこと。**
# 詳細: docs/OFFLINE_INSTALL_HARDENING_2026-07-28.md
RERANKER_ALLOW_REMOTE=false

# 画像PDF・画像ファイルの文字認識(OCR)で使う言語。未設定だと上流既定の "eng" のみになり、
# 日本語のスキャン文書が英語として誤認識される。jpn/eng の言語データは配布物に同梱済み
# (app\server\storage\models\tesseract\)。同梱していない言語をここに足すと、
# OCR_ALLOW_REMOTE=false のため日本語エラーで停止する(CDNへは取りに行かない)。
TARGET_OCR_LANG=jpn,eng

# --- Local service control (Web UIからの各サービス起動/停止) ---
# ServerはLocalSystemで動くWindowsサービスのため sc.exe でOllama/Collectorを制御できる。
# winsw以外の値/未設定なら制御機能は無効(状態表示のみ)。
LOCAL_SERVICE_CONTROL=winsw
LLM_SERVICE_NAME=LocalRAG-Ollama
COLLECTOR_SERVICE_NAME=LocalRAG-Collector
